# Edge cases

$productCatalog=exampleProductCatalog
$productCatalogVersion=Online
$catalogVersion=catalogVersion(catalog(id[default=$productCatalog]),version[default=$productCatalogVersion])[unique=true,default=$productCatalog:$productCatalogVersion]

INSERT_UPDATE Product[batchmode=true];code[unique=true];$catalogVersion;name[lang=en];supercategories(code,catalogVersion(catalog(id),version))[collection-delimiter=|,mode=append];description[lang=de,allownull=true]
